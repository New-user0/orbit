      },
      "accent": "$hue.cyan",
      "interactive": "$hue.cyan",
      "neutral": "$hue.gray"
    },
    "text": {
      "action": {
        "primary": {
          "$focused": "#ffffff"
        },
        "destructive": {
          "base": "#ffffff"
        }
      }
    },
    "diff": {
      "background": {
        "added": "#dff2e7",
        "removed": "#f8e1e1"
      },
      "highlight": {
        "added": "#bfe5cf",
        "removed": "#f0c2c2"
      },
      "lineNumber": {
        "background": {
          "added": "#d2ebdc",
          "removed": "#f0d5d5"
        }
      }
    }
  },
