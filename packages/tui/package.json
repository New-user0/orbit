{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@orbit/tui",
  "version": "2.0.22",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "bun ../../tools/test/run.ts --timeout 30000 --only-failures",
    "test:timings": "bun ../../tools/test/run.ts --timeout 30000 --only-failures --update-timings",
    "typecheck": "tsgo -b"
  },
  "exports": {
    ".": "./src/index.tsx",
    "./config": "./src/config/index.tsx",
    "./config/keybind": "./src/config/keybind.ts",
    "./config/keybindings-file": "./src/config/keybindings-file.ts",
    "./config/v1": "./src/config/v1/index.tsx",
    "./config/v1/keybind": "./src/config/v1/keybind.ts",
    "./context/args": "./src/context/args.tsx",
    "./context/epilogue": "./src/context/epilogue.tsx",
    "./context/exit": "./src/context/exit.tsx",
    "./context/log": "./src/context/log.tsx",
    "./context/runtime": "./src/context/runtime.tsx",
    "./context/storage": "./src/context/storage.tsx",
    "./context/client": "./src/context/client.tsx",
    "./context/theme": "./src/context/theme.tsx",
    "./theme/discovery": "./src/theme/discovery.ts",
    "./plugin/discovery": "./src/plugin/discovery.ts",
    "./context/editor": "./src/context/editor.ts",
    "./context/clipboard": "./src/context/clipboard.tsx",
    "./attention": "./src/attention.ts",
    "./editor": "./src/editor.ts",
    "./mini": "./src/mini/index.ts",
    "./mini/tool": "./src/mini/tool.public.ts",
    "./model-preference": "./src/model-preference.ts",
    "./runtime": "./src/runtime.tsx",
    "./terminal-win32": "./src/terminal-win32.ts",
    "./context/keymap": "./src/context/keymap.tsx",
    "./prompt/content": "./src/prompt/content.ts",
    "./prompt/display": "./src/prompt/display.ts",
    "./parsers-config": "./src/parsers-config.ts",
    "./util/error": "./src/util/error.ts",
    "./util/filetype": "./src/util/filetype.ts",
    "./util/form": "./src/util/form.ts",
    "./util/locale": "./src/util/locale.ts",
    "./util/persistence": "./src/util/persistence.ts",
    "./util/record": "./src/util/record.ts",
    "./util/session": "./src/util/session.ts",
    "./util/string-width": "./src/util/string-width.ts",
    "./logo": "./src/logo.ts",
    "./ui/dialog": "./src/ui/dialog.tsx",
    "./ui/spinner": "./src/ui/spinner.ts",
    "./ui/toast": "./src/ui/toast.tsx",
    "./component/spinner": "./src/component/spinner.tsx",
    "./component/register-spinner": "./src/component/register-spinner.ts"
  },
  "imports": {
    "#attention-sounds": {
      "bun": "./src/attention-sounds.bun.ts",
      "node": "./src/attention-sounds.node.ts",
      "default": "./src/attention-sounds.bun.ts"
    },
    "#string-width": {
      "bun": "./src/util/string-width.bun.ts",
      "node": "./src/util/string-width.node.ts",
      "default": "./src/util/string-width.bun.ts"
    },
    "#runtime-plugin-support": {
      "bun": "./src/plugin/runtime-plugin-support.bun.ts",
      "node": "./src/plugin/runtime-plugin-support.node.ts",
      "default": "./src/plugin/runtime-plugin-support.node.ts"
    }
  },
  "dependencies": {
    "@orbit/client": "workspace:*",
    "@orbit/compat": "workspace:*",
    "@orbit/core": "workspace:*",
    "@orbit/flow": "workspace:*",
    "@orbit/latex": "workspace:*",
    "@orbit/merman": "workspace:*",
    "@orbit/plugin": "workspace:*",
    "@orbit/schema": "workspace:*",
    "@orbit/simulation": "workspace:*",
    "@orbit/theme": "workspace:*",
    "@orbit/util": "workspace:*",
    "@opentui/core": "catalog:",
    "@opentui/keymap": "catalog:",
    "@opentui/solid": "catalog:",
    "@solid-primitives/event-bus": "1.1.2",
    "cross-spawn": "catalog:",
    "effect": "catalog:",
    "fuzzysort": "catalog:",
    "get-east-asian-width": "catalog:",
    "jsonc-parser": "3.3.1",
    "opentui-spinner": "catalog:",
    "remeda": "catalog:",
    "solid-js": "catalog:",
    "string-width": "catalog:",
    "strip-ansi": "7.1.2",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@types/cross-spawn": "catalog:",
    "@typescript/native-preview": "catalog:"
  }
}
