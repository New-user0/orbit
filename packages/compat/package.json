{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@orbit/compat",
  "version": "2.0.22",
  "description": "Every name, root and switch that lets Orbit read other agent products' files",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://orbit.invalid",
    "directory": "packages/compat"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./*": "./src/*.ts"
  },
  "imports": {
    "#zed-sqlite": {
      "bun": "./src/zed-sqlite.bun.ts",
      "node": "./src/zed-sqlite.node.ts",
      "default": "./src/zed-sqlite.bun.ts"
    }
  },
  "scripts": {
    "build": "bun run script/build.ts",
    "typecheck": "tsgo --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@orbit/schema": "workspace:*",
    "@orbit/util": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:"
  }
}
